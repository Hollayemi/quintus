# Request-quote API (app/api/request-quote) sends mail through Zoho Mail SMTP.
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The Zoho mailbox that authenticates and sends (e.g. hello@quintusprojects.com).
ZOHO_SMTP_USER=hello@quintusprojects.com

# Zoho app-specific password (Zoho Accounts -> Security -> App Passwords).
# Required if two-factor auth is on for the mailbox. Do not use the normal login password.
ZOHO_SMTP_PASS=

# Optional. Defaults shown.
# Use the host for your Zoho data centre: smtp.zoho.com | smtp.zoho.eu | smtp.zoho.in | smtp.zoho.com.au | smtp.zoho.jp
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
# Must be the authenticated mailbox or one of its aliases. Defaults to ZOHO_SMTP_USER.
# ZOHO_FROM=hello@quintusprojects.com
# Where quote requests are delivered. Defaults to hello@quintusprojects.com.
# QUOTE_TO_EMAIL=hello@quintusprojects.com
